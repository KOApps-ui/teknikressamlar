                            divisions: 25,
                            activeColor: AppTheme.cyanLine,
                            inactiveColor: AppTheme.steelBorder,
                            onChanged: (v) => setState(() => _experienceYears = v.round()),
                          ),
                        ],
                      ),
                    ),
