                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 14),

              Row(
                children: [
                  Expanded(
                    child: TextFormField(
                      controller: _linkedinController,
                      decoration: const InputDecoration(
                        labelText: 'LinkedIn Profil Linki',
                        hintText: 'https://linkedin.com/in/...',
                        prefixIcon: Icon(Icons.link, color: AppTheme.cyanLine),
