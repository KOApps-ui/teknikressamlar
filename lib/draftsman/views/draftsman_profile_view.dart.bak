                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text('Deneyim: $_experienceYears Yıl',
                              style: const TextStyle(fontSize: 12, color: AppTheme.cyanLine)),
                          Slider(
                            value: _experienceYears.toDouble(),
                            min: 0,
