                  Expanded(
                    child: TextFormField(
                      controller: _kariyerNetController,
                      decoration: const InputDecoration(
                        labelText: 'Kariyer.net Profil Linki',
                        hintText: 'https://kariyer.net/ozgecmis/...',
                        prefixIcon: Icon(Icons.work_outline, color: AppTheme.amberSteel),
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 14),

              TextFormField(
                controller: _bioController,
                maxLines: 3,
                decoration: const InputDecoration(
                  labelText: 'Teknik Tecrübe ve İmalat Özeti',
                  hintText: 'Uyguladığınız çelik/betonarme projeler, birleşim detayları, metraj çıkarma...',
                ),
              ),
              const SizedBox(height: 20),

              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text(
                    'Kullandığınız CAD / BIM Yazılımları',
                    style: TextStyle(fontSize: 14, fontWeight: FontWeight.bold, color: AppTheme.cyanLine),
                  ),
                  TextButton.icon(
                    icon: const Icon(Icons.add_circle_outline, size: 16, color: AppTheme.amberSteel),
                    label: const Text('Program Ekle', style: TextStyle(color: AppTheme.amberSteel, fontSize: 12, fontWeight: FontWeight.bold)),
                    onPressed: _showAddCustomSkillDialog,
                  ),
                ],
              ),
              const SizedBox(height: 8),
              Wrap(
                spacing: 8,
                runSpacing: 8,
                children: [
                  ...availableSkills.map((skill) {
                    final isSelected = _selectedSkills.contains(skill);
                    return FilterChip(
                      label: Text(skill),
                      selected: isSelected,
                      selectedColor: AppTheme.cyanLine.withValues(alpha: 0.2),
                      checkmarkColor: AppTheme.cyanLine,
                      labelStyle: TextStyle(
                        color: isSelected ? AppTheme.cyanLine : AppTheme.textMuted,
                        fontSize: 12,
                        fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                      ),
                      backgroundColor: AppTheme.blueprintSurface,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(8),
                        side: BorderSide(
                          color: isSelected ? AppTheme.cyanLine : AppTheme.steelBorder,
                        ),
                      ),
                      onSelected: (selected) {
                        setState(() {
                          if (selected) {
                            _selectedSkills.add(skill);
                          } else {
                            _selectedSkills.remove(skill);
                          }
                        });
                      },
                    );
                  }),
                  ..._customSkills.map((skill) {
                    final isSelected = _selectedSkills.contains(skill);
                    return FilterChip(
                      label: Text(skill),
                      selected: isSelected,
                      selectedColor: AppTheme.amberSteel.withValues(alpha: 0.2),
                      checkmarkColor: AppTheme.amberSteel,
                      labelStyle: TextStyle(
                        color: isSelected ? AppTheme.amberSteel : AppTheme.textMuted,
                        fontSize: 12,
                        fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                      ),
                      backgroundColor: AppTheme.blueprintSurface,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(8),
                        side: BorderSide(
                          color: isSelected ? AppTheme.amberSteel : AppTheme.steelBorder,
                        ),
                      ),
                      onSelected: (selected) {
                        setState(() {
                          if (selected) {
                            _selectedSkills.add(skill);
                          } else {
                            _selectedSkills.remove(skill);
                          }
                        });
                      },
                      onDeleted: () {
                        setState(() {
                          _customSkills.remove(skill);
                          _selectedSkills.remove(skill);
                        });
                      },
                      deleteIcon: const Icon(Icons.cancel, size: 14, color: AppTheme.statusDanger),
                    );
                  }),
                  ActionChip(
                    avatar: const Icon(Icons.add_circle, size: 16, color: AppTheme.amberSteel),
                    label: const Text('+ Program Ekle', style: TextStyle(color: AppTheme.amberSteel, fontSize: 12, fontWeight: FontWeight.bold)),
                    backgroundColor: AppTheme.blueprintSurface,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(8),
                      side: const BorderSide(color: AppTheme.amberSteel, width: 1),
                    ),
                    onPressed: _showAddCustomSkillDialog,
                  ),
                ],
              ),
              const SizedBox(height: 24),

              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Expanded(
                    child: Text(
                      'Portföy ve Çizim Dosyaları',
                      style: TextStyle(fontSize: 14, fontWeight: FontWeight.bold, color: AppTheme.cyanLine),
                    ),
                  ),
                  const SizedBox(width: 8),
                  ElevatedButton.icon(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: AppTheme.amberSteel,
                      foregroundColor: AppTheme.blueprintDark,
                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                    ),
                    icon: const Icon(Icons.add, size: 18),
                    label: const Text('Dosya Ekle', style: TextStyle(fontSize: 12)),
                    onPressed: _pickAndAddFile,
                  ),
                ],
              ),
              const SizedBox(height: 8),
              if (_portfolioFiles.isEmpty)
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(20),
                  decoration: BoxDecoration(
                    color: AppTheme.blueprintSurface,
                    borderRadius: BorderRadius.circular(10),
                    border: Border.all(color: AppTheme.steelBorder),
                  ),
                  child: const Center(
                    child: Text(
                      'Henüz portföy çizimi eklemediniz.\nİşveren şirketlerin sizi tercih etmesi için referans DWG/DXF/PDF ekleyin.',
                      textAlign: TextAlign.center,
                      style: TextStyle(color: AppTheme.textSubtle, fontSize: 12),
                    ),
                  ),
                )
              else
                ..._portfolioFiles.map((f) => _buildFileTile(f)),
              const SizedBox(height: 28),

              SizedBox(
                width: double.infinity,
                child: ElevatedButton.icon(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: AppTheme.cyanLine,
                    foregroundColor: AppTheme.blueprintDark,
                    padding: const EdgeInsets.symmetric(vertical: 16),
                  ),
                  icon: const Icon(Icons.shield_outlined),
                  label: Text(
                    _currentProfile == null ? 'KAYDET & AĞA BAĞLAN' : 'PROFİLİ GÜNCELLE & AĞDA YAYINLA',
                    style: const TextStyle(fontWeight: FontWeight.bold, letterSpacing: 0.5),
                  ),
                  onPressed: _saveProfile,
                ),
              ),
              if (_currentProfile != null) ...[
                const SizedBox(height: 14),
                SizedBox(
                  width: double.infinity,
                  child: OutlinedButton.icon(
                    style: OutlinedButton.styleFrom(
                      foregroundColor: AppTheme.amberSteel,
                      side: const BorderSide(color: AppTheme.amberSteel),
                      padding: const EdgeInsets.symmetric(vertical: 14),
                    ),
                    icon: const Icon(Icons.logout),
                    label: const Text('HESAPTAN ÇIKIŞ YAP'),
                    onPressed: _signOut,
                  ),
                ),
                const SizedBox(height: 12),
                SizedBox(
                  width: double.infinity,
                  child: OutlinedButton.icon(
                    style: OutlinedButton.styleFrom(
                      foregroundColor: AppTheme.statusDanger,
                      side: const BorderSide(color: AppTheme.statusDanger),
                      padding: const EdgeInsets.symmetric(vertical: 14),
                    ),
                    icon: const Icon(Icons.delete_forever),
                    label: const Text('KAYDI & PROFİLİ KALICI SİL (SIFIRLA)'),
                    onPressed: _deleteAccount,
                  ),
                ),
              ],
              const SizedBox(height: 30),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildCryptoIdentityCard() {
    final pubKey = _currentProfile?.publicKey ?? 'Oluşturuluyor...';
    final did = _currentProfile?.id ?? 'did:ko:tr:initial';

    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppTheme.blueprintSurface,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AppTheme.cyanLine.withValues(alpha: 0.4)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(Icons.lock_clock_outlined, color: AppTheme.cyanLine, size: 20),
              const SizedBox(width: 8),
              const Expanded(
                child: Text(
                  'Zero-Server Kriptografik Kimlik (DID)',
                  style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: AppTheme.cyanLine),
                  overflow: TextOverflow.ellipsis,
                ),
              ),
              const SizedBox(width: 8),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                decoration: BoxDecoration(
                  color: AppTheme.statusSuccess.withValues(alpha: 0.2),
                  borderRadius: BorderRadius.circular(4),
                ),
                child: const Text(
                  'GİZLİ & ŞİFRELİ',
                  style: TextStyle(color: AppTheme.statusSuccess, fontSize: 9, fontWeight: FontWeight.bold),
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            'P2P Açık Anahtar (Public Key): $did',
            style: const TextStyle(
              fontSize: 11,
              fontFamily: 'monospace',
              color: AppTheme.textMuted,
            ),
            overflow: TextOverflow.ellipsis,
          ),
          const SizedBox(height: 4),
          Row(
            mainAxisAlignment: MainAxisAlignment.end,
            children: [
              InkWell(
                onTap: () {
                  Clipboard.setData(ClipboardData(text: pubKey));
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Açık anahtar panoya kopyalandı.')),
                  );
                },
                child: const Padding(
                  padding: EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(Icons.copy, size: 12, color: AppTheme.cyanLine),
                      SizedBox(width: 4),
                      Text('Açık Anahtar', style: TextStyle(color: AppTheme.cyanLine, fontSize: 11)),
                    ],
                  ),
                ),
              ),
              const SizedBox(width: 12),
              InkWell(
                onTap: _showSecretKeyDialog,
                child: const Padding(
                  padding: EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(Icons.vpn_key_rounded, size: 12, color: AppTheme.amberSteel),
                      SizedBox(width: 4),
                      Text('Kurtarma Anahtarı (Yedekle)', style: TextStyle(color: AppTheme.amberSteel, fontSize: 11, fontWeight: FontWeight.bold)),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  void _showSecretKeyDialog() {
    final privKey = _currentProfile?.privateKey ?? '';
    if (privKey.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Kurtarma anahtarı henüz oluşturulmadı. Önce profili kaydedin.')),
      );
      return;
    }

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppTheme.blueprintDark,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(16),
          side: const BorderSide(color: AppTheme.amberSteel, width: 1.5),
        ),
        title: const Row(
          children: [
            Icon(Icons.vpn_key_rounded, color: AppTheme.amberSteel),
            SizedBox(width: 8),
            Expanded(
              child: Text(
                'Gizli Kurtarma Anahtarı',
                style: TextStyle(color: AppTheme.textLight, fontSize: 16, fontWeight: FontWeight.bold),
              ),
            ),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              '⚠️ Bu anahtar hesabınızın sahibini kanıtlayan tek şifredir!\n\nUygulamayı silseniz veya telefon değiştirseniz dahi, bu 64 haneli anahtarı yapıştırarak tüm profilinizi anında geri yükleyebilirsiniz.',
              style: TextStyle(fontSize: 13, color: AppTheme.textMuted, height: 1.4),
            ),
            const SizedBox(height: 14),
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: AppTheme.blueprintSurface,
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: AppTheme.amberSteel.withValues(alpha: 0.5)),
              ),
              child: SelectableText(
                privKey,
                style: const TextStyle(fontFamily: 'monospace', fontSize: 11, color: AppTheme.amberSteel),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Kapat', style: TextStyle(color: AppTheme.textMuted)),
          ),
          ElevatedButton.icon(
            style: ElevatedButton.styleFrom(
              backgroundColor: AppTheme.amberSteel,
              foregroundColor: AppTheme.blueprintDark,
            ),
            icon: const Icon(Icons.copy, size: 16),
            label: const Text('Anahtarı Kopyala', style: TextStyle(fontWeight: FontWeight.bold)),
            onPressed: () {
              Clipboard.setData(ClipboardData(text: privKey));
              Navigator.of(ctx).pop();
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(
                  backgroundColor: AppTheme.statusSuccess,
                  content: Text('✓ Gizli kurtarma anahtarı panoya kopyalandı. Güvenli bir yere kaydedin!'),
                ),
              );
            },
          ),
        ],
      ),
    );
  }

  void _showRestoreAccountDialog() {
    final keyController = TextEditingController();
    bool isRestoring = false;

    showDialog(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx, setDialogState) => AlertDialog(
          backgroundColor: AppTheme.blueprintDark,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(16),
            side: const BorderSide(color: AppTheme.cyanLine, width: 1.5),
          ),
          title: const Row(
            children: [
              Icon(Icons.settings_backup_restore, color: AppTheme.cyanLine),
              SizedBox(width: 8),
              Expanded(
                child: Text(
                  'Hesabı Geri Yükle',
                  style: TextStyle(color: AppTheme.textLight, fontSize: 16, fontWeight: FontWeight.bold),
                ),
              ),
            ],
          ),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'Daha önce yedeklediğiniz 64 haneli Gizli Kurtarma Anahtarınızı (Private Key) aşağıya yapıştırın:',
                style: TextStyle(fontSize: 13, color: AppTheme.textMuted, height: 1.4),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: keyController,
                maxLines: 2,
                style: const TextStyle(fontFamily: 'monospace', fontSize: 12, color: AppTheme.cyanLine),
                decoration: const InputDecoration(
                  hintText: '64 karakterli hex anahtar...',
                  labelText: 'Kurtarma Anahtarı',
                  prefixIcon: Icon(Icons.key, color: AppTheme.cyanLine),
                ),
              ),
              if (isRestoring) ...[
                const SizedBox(height: 16),
                const Center(
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2, color: AppTheme.cyanLine)),
                      SizedBox(width: 10),
                      Text('Nostr ağından profil aranıyor...', style: TextStyle(fontSize: 12, color: AppTheme.cyanLine)),
                    ],
                  ),
                ),
              ],
            ],
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(ctx).pop(),
              child: const Text('İptal', style: TextStyle(color: AppTheme.textMuted)),
            ),
            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: AppTheme.cyanLine,
                foregroundColor: AppTheme.blueprintDark,
              ),
              onPressed: isRestoring
                  ? null
                  : () async {
                      final input = keyController.text.trim();
                      if (input.isEmpty) return;
                      setDialogState(() => isRestoring = true);

                      final res = await _authService.restoreWithPrivateKey(
                        privateKey: input,
                        role: 'draftsman',
                      );

                      if (!ctx.mounted || !mounted) return;
                      Navigator.of(ctx).pop();

                      if (res.isSuccess && res.profile != null) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          SnackBar(
                            backgroundColor: AppTheme.statusSuccess,
                            content: Text('✓ Hoş geldiniz! ${res.profile!.name} hesabı başarıyla geri yüklendi.'),
                          ),
                        );
                        await _loadProfile();
                        await _p2pService.start(userProfile: res.profile!);
                        widget.onProfileSaved?.call();
                      } else {
                        ScaffoldMessenger.of(context).showSnackBar(
                          SnackBar(
                            backgroundColor: AppTheme.statusDanger,
                            content: Text(res.errorMessage ?? 'Geri yükleme başarısız.'),
                          ),
                        );
                      }
                    },
              child: const Text('GERİ YÜKLE & GİRİŞ YAP', style: TextStyle(fontWeight: FontWeight.bold)),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildRestoreAccountBanner() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      decoration: BoxDecoration(
        color: AppTheme.amberSteel.withValues(alpha: 0.1),
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: AppTheme.amberSteel.withValues(alpha: 0.3)),
      ),
      child: Row(
        children: [
          const Icon(Icons.settings_backup_restore, color: AppTheme.amberSteel, size: 18),
          const SizedBox(width: 8),
          const Expanded(
            child: Text(
              'Uygulamayı yeniden mi kurdunuz? Eski hesabınızı geri yükleyin.',
              style: TextStyle(fontSize: 11, color: AppTheme.textLight),
            ),
          ),
          TextButton(
            onPressed: _showRestoreAccountDialog,
            style: TextButton.styleFrom(
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
              minimumSize: Size.zero,
              tapTargetSize: MaterialTapTargetSize.shrinkWrap,
            ),
            child: const Text(
              'Geri Yükle',
              style: TextStyle(color: AppTheme.amberSteel, fontWeight: FontWeight.bold, fontSize: 11),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildEDevletVerificationCard() {
    final hasBarcode = _diplomaBarcodeController.text.trim().isNotEmpty;
    final displayBarcode = _diplomaBarcodeController.text.trim();

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: AppTheme.blueprintSurface,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: hasBarcode ? AppTheme.cyanLine.withValues(alpha: 0.8) : AppTheme.steelBorder,
          width: 1.5,
        ),
        boxShadow: hasBarcode
            ? [
                BoxShadow(
                  color: AppTheme.cyanLine.withValues(alpha: 0.08),
                  blurRadius: 10,
                  offset: const Offset(0, 3),
                )
              ]
            : null,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                hasBarcode ? Icons.verified : Icons.verified_user_outlined,
                color: hasBarcode ? AppTheme.cyanLine : AppTheme.textMuted,
                size: 22,
              ),
              const SizedBox(width: 8),
              const Expanded(
                child: Text(
                  'e-Devlet Barkodlu Mezuniyet Belgesi (PDF)',
                  style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: AppTheme.textLight),
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: hasBarcode
                      ? AppTheme.statusSuccess.withValues(alpha: 0.15)
                      : AppTheme.steelBorder.withValues(alpha: 0.3),
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(
                    color: hasBarcode
                        ? AppTheme.statusSuccess.withValues(alpha: 0.6)
                        : AppTheme.steelBorder,
                  ),
                ),
                child: Text(
                  hasBarcode ? '✓ DOĞRULANABİLİR BELGE' : 'BELGE BEKLENİYOR',
                  style: TextStyle(
                    color: hasBarcode ? AppTheme.statusSuccess : AppTheme.textMuted,
                    fontSize: 10,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 10),

          if (!hasBarcode) ...[
            const Text(
              'turkiye.gov.tr üzerinden indirdiğiniz YÖK veya MEB onaylı Barkodlu Mezuniyet Belgenizi (PDF) yükleyin. Barkod numarası belgeden otomatik çıkarılır, maske altında güvenle korunur ve şirketlerin e-Devlet kapısında teyit edebilmesini sağlar.',
              style: TextStyle(color: AppTheme.textMuted, fontSize: 11.5, height: 1.35),
            ),
            const SizedBox(height: 14),
            Row(
              children: [
                Expanded(
                  child: ElevatedButton.icon(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: AppTheme.cyanLine,
                      foregroundColor: AppTheme.blueprintDark,
                      padding: const EdgeInsets.symmetric(vertical: 13),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                    ),
                    icon: _isExtractingDiploma
                        ? const SizedBox(
                            width: 16,
                            height: 16,
                            child: CircularProgressIndicator(strokeWidth: 2, color: AppTheme.blueprintDark),
                          )
                        : const Icon(Icons.picture_as_pdf, size: 18),
                    label: Text(
                      _isExtractingDiploma ? 'Barkod Ayıklanıyor...' : 'Barkodlu Belgeyi Seç (PDF)',
                      style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 12),
                    ),
                    onPressed: _isExtractingDiploma ? null : _pickDiplomaPdf,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 6),
            Align(
              alignment: Alignment.centerRight,
              child: TextButton(
                onPressed: () => _showManualBarcodeInputDialog(
                  pdfPath: '',
                  pdfName: 'Mezuniyet Belgesi',
                  fileSize: 0,
                  reason: 'Barkod numaranızı belgenizin altındaki barkod kutusundan bakarak manuel girebilirsiniz.',
                ),
                style: TextButton.styleFrom(
                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                  minimumSize: Size.zero,
                  tapTargetSize: MaterialTapTargetSize.shrinkWrap,
                ),
                child: const Text(
                  'veya Barkod Numarasını Manuel Gir',
                  style: TextStyle(fontSize: 11, color: AppTheme.cyanLine),
                ),
              ),
            ),
          ] else ...[
            Row(
              children: [
                const Icon(Icons.school, size: 16, color: AppTheme.cyanLine),
                const SizedBox(width: 6),
                Expanded(
                  child: Text(
                    _verificationBadge ?? 'e-Devlet Onaylı Mezuniyet Belgesi',
                    style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w600, color: AppTheme.cyanLine),
                  ),
                ),
                if (_diplomaFileName != null)
                  Text(
                    _diplomaFileName!,
                    style: const TextStyle(fontSize: 11, color: AppTheme.textMuted),
                    overflow: TextOverflow.ellipsis,
                  ),
              ],
            ),
            const SizedBox(height: 10),

            // Maskelenmiş Barkod Kutusu
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
              decoration: BoxDecoration(
                color: AppTheme.blueprintDark,
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: AppTheme.cyanLine.withValues(alpha: 0.4)),
              ),
              child: Row(
                children: [
                  const Icon(Icons.qr_code_scanner, color: AppTheme.cyanLine, size: 20),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Text(
                          'BELGE BARKOD NUMARASI (GÜVENLİ MASKE):',
                          style: TextStyle(fontSize: 9, color: AppTheme.textMuted, letterSpacing: 0.5),
                        ),
                        const SizedBox(height: 3),
                        Text(
                          _isBarcodeMaskedVisible
                              ? displayBarcode
                              : EDevletService.maskBarcode(displayBarcode),
                          style: const TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.bold,
                            letterSpacing: 1.5,
                            fontFamily: 'monospace',
                            color: AppTheme.textLight,
                          ),
                        ),
                      ],
                    ),
                  ),
                  IconButton(
                    icon: Icon(
                      _isBarcodeMaskedVisible ? Icons.visibility_off : Icons.visibility,
                      color: AppTheme.textMuted,
                      size: 20,
                    ),
                    tooltip: _isBarcodeMaskedVisible ? 'Barkodu Gizle' : 'Barkodu Göster',
                    onPressed: () {
                      setState(() {
                        _isBarcodeMaskedVisible = !_isBarcodeMaskedVisible;
                      });
                    },
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),

            // İşlem Butonları
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                ElevatedButton.icon(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: AppTheme.cyanLine,
                    foregroundColor: AppTheme.blueprintDark,
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 9),
                  ),
                  icon: const Icon(Icons.copy, size: 15),
                  label: const Text('Kopyala', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 11)),
                  onPressed: () => EDevletService.copyToClipboard(context, displayBarcode),
                ),
                OutlinedButton.icon(
                  style: OutlinedButton.styleFrom(
                    foregroundColor: AppTheme.cyanLine,
                    side: BorderSide(color: AppTheme.cyanLine.withValues(alpha: 0.6)),
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 9),
                  ),
                  icon: const Icon(Icons.open_in_browser, size: 15),
                  label: const Text('e-Devlet\'te Doğrula', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 11)),
                  onPressed: () => EDevletService.openOfficialVerificationPortal(context, barcode: displayBarcode),
                ),
                if (_diplomaFilePath != null || _portfolioFiles.any((f) => f.fileExtension == 'pdf'))
                  TextButton.icon(
                    style: TextButton.styleFrom(
                      foregroundColor: AppTheme.textLight,
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
                    ),
                    icon: const Icon(Icons.picture_as_pdf, size: 15),
                    label: const Text('Belgeyi Aç', style: TextStyle(fontSize: 11)),
                    onPressed: _openDiplomaPdf,
                  ),
                TextButton.icon(
                  style: TextButton.styleFrom(
                    foregroundColor: AppTheme.cyanLine,
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 9),
                  ),
                  icon: const Icon(Icons.change_circle_outlined, size: 15),
                  label: const Text('Değiştir', style: TextStyle(fontSize: 11)),
                  onPressed: _pickDiplomaPdf,
                ),
                TextButton.icon(
                  style: TextButton.styleFrom(
                    foregroundColor: AppTheme.statusDanger,
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 9),
                  ),
                  icon: const Icon(Icons.delete_outline, size: 15),
                  label: const Text('Kaldır', style: TextStyle(fontSize: 11)),
                  onPressed: _removeDiploma,
                ),
              ],
            ),
          ],
        ],
      ),
    );
  }

  Widget _buildFileTile(PortfolioFile file) {
    final formattedName = FileHelper.formatFileName(file.fileName, maxLength: 28);
    final formattedSize = FileHelper.formatFileSize(file.fileSize);

    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: AppTheme.blueprintSurface,
        borderRadius: BorderRadius.circular(10),
        border: Border.all(color: AppTheme.steelBorder),
      ),
      child: Row(
        children: [
          FileHelper.buildFileIconBadge(file.fileExtension, size: 42),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Tooltip(
                  message: file.fileName,
                  child: Text(
                    formattedName,
                    style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 13, color: AppTheme.textLight),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  '$formattedSize • Cihazda Saklı',
                  style: const TextStyle(fontSize: 11, color: AppTheme.textMuted),
                ),
              ],
            ),
          ),
          IconButton(
            icon: const Icon(Icons.open_in_new, size: 20, color: AppTheme.cyanLine),
            tooltip: 'Dosyayı Aç / Görüntüle',
            onPressed: () async {
              final ok = await FileLauncherService.openFile(file.filePath);
              if (!ok && mounted) {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    backgroundColor: AppTheme.statusDanger,
                    content: Text('Dosya açılamadı veya cihazda uygun görüntüleyici bulunamadı.'),
                  ),
                );
              }
            },
          ),
          IconButton(
            icon: const Icon(Icons.delete_outline, size: 20, color: AppTheme.statusDanger),
            tooltip: 'Dosyayı Kaldır',
            onPressed: () => _removeFile(file.id),
          ),
        ],
      ),
    );
  }
}
