                dropdownColor: AppTheme.blueprintSurface,
                style: const TextStyle(color: AppTheme.textLight, fontSize: 14),
                decoration: const InputDecoration(
                  labelText: 'Uzmanlık Ünvanı Seçimi',
                  hintText: 'Uzmanlık ünvanınızı seçiniz...',
                  prefixIcon: Icon(Icons.badge, color: AppTheme.cyanLine),
                ),
                hint: const Text('Uzmanlık ünvanınızı seçiniz...', style: TextStyle(color: AppTheme.textMuted, fontSize: 14)),
                items: [
                  ..._getAvailableTitlesForBranch().map((t) {
                    return DropdownMenuItem(
                      value: t,
                      child: Text(t, overflow: TextOverflow.ellipsis),
                    );
                  }),
                  const DropdownMenuItem(
                    value: 'custom',
                    child: Text('✍️ Diğer (Özel Ünvan Yaz...)',
                        style: TextStyle(color: AppTheme.amberSteel, fontWeight: FontWeight.bold)),
                  ),
                ],
                validator: (val) {
                  if (val == null || val.trim().isEmpty) {
                    return 'Lütfen uzmanlık ve ünvanınızı seçiniz!';
                  }
                  if (val == 'custom' && _titleController.text.trim().isEmpty) {
                    return 'Lütfen özel ünvanınızı yazınız!';
                  }
                  return null;
                },
                onChanged: (val) {
                  setState(() {
                    _selectedTitle = val;
                    _isCustomTitle = (val == 'custom');
                    if (!_isCustomTitle && val != null) {
                      _titleController.text = val;
                    } else if (_isCustomTitle) {
                      _titleController.clear();
                    }
                  });
                },
              ),
              if (_isCustomTitle) ...[
